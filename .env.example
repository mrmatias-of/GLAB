# MySQL (use a URL-encoded password)
DATABASE_URL=mysql://user:password@host:3306/database
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=https://glabcursos.com.br

# Transactional email — configure these as Vercel Secrets, never in Git.
EMAIL_FROM=G-LAB <no-reply@glabcursos.com.br>
EMAIL_REPLY_TO=suporte@glabcursos.com.br
SMTP_HOST=smtp.seu-provedor.com.br
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@glabcursos.com.br
SMTP_PASSWORD=your-smtp-password

# Admin access; comma-separated e-mail addresses.
GLAB_ADMIN_EMAILS=admin@glabcursos.com.br
